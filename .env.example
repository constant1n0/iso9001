# =============================================================================
# ISO9001 QMS - Archivo de Configuración de Entorno
# =============================================================================
# Copia este archivo a .env y configura los valores según tu entorno
# IMPORTANTE: Nunca subas el archivo .env a control de versiones
# =============================================================================

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE LA APLICACIÓN
# -----------------------------------------------------------------------------
# Modo de depuración (True solo para desarrollo, False para producción)
FLASK_DEBUG=False

# Clave secreta para sesiones y tokens CSRF
# IMPORTANTE: Genera una clave única y segura para producción
# Puedes generar una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-una-clave-secreta-segura-de-al-menos-32-caracteres

# -----------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL)
# -----------------------------------------------------------------------------
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_base_datos
DATABASE_URI=postgresql://usuario:contraseña@localhost:5432/iso9001

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE CORREO (Gmail SMTP)
# -----------------------------------------------------------------------------
# Para usar Gmail, debes habilitar "Contraseñas de aplicación" en tu cuenta:
# https://myaccount.google.com/apppasswords
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-contraseña-de-aplicacion
MAIL_DEFAULT_SENDER=tu-correo@gmail.com

# -----------------------------------------------------------------------------
# CELERY (Notificaciones programadas por correo, con Redis como broker)
# -----------------------------------------------------------------------------
# Solo lo usan el worker y beat de Celery (celery_worker.py); la aplicación web
# funciona sin estas variables. Si Redis tiene contraseña:
#   redis://:CONTRASEÑA@localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
# Opcional: las tareas no guardan resultados, así que puede quedar vacío.
CELERY_RESULT_BACKEND=

# Zona horaria de las tareas programadas y de las fechas locales
APP_TIMEZONE=Europe/Madrid
